// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  passenger
  driver
  admin
}

enum VehicleType {
  car
  motorcycle
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum TripStatus {
  pending
  accepted
  in_progress
  completed
  cancelled
}

enum WalletTransactionType {
  paypal_topup
  trip_charge
  trip_payout
  withdrawal_adjustment
  platform_commission
  cancellation_fee
  cancellation_payout
}

enum WithdrawalStatus {
  pending
  completed
  rejected
}

enum NotificationType {
  trip_accepted
  trip_started
  trip_completed
  trip_cancelled
  withdrawal_resolved
  driver_verification_updated
  rating_received
  driver_arrived
}

enum SavedAddressLabel {
  home
  work
  other
}

enum IncidentReportCategory {
  safety
  driver_behavior
  vehicle_condition
  payment
  other
}

enum IncidentReportStatus {
  pending
  reviewed
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?  @unique
  passwordHash    String?  @map("password_hash")
  googleId        String?  @unique @map("google_id")
  profilePhotoUrl String?  @map("profile_photo_url")
  role            Role
  createdAt       DateTime @default(now()) @map("created_at")
  isActive        Boolean  @default(true) @map("is_active")

  driver               Driver?
  wallet               Wallet?
  tripsAsPassenger     Trip[]              @relation("PassengerTrips")
  ratingsGiven         Rating[]            @relation("RaterRatings")
  ratingsReceived      Rating[]            @relation("RatedRatings")
  resolvedWithdrawals  WithdrawalRequest[] @relation("AdminResolvedWithdrawals")
  notifications        Notification[]
  savedAddresses       SavedAddress[]
  incidentReportsFiled IncidentReport[]    @relation("ReporterIncidentReports")

  @@map("users")
}

model Driver {
  id                     String             @id @default(uuid())
  userId                 String             @unique @map("user_id")
  vehicleType            VehicleType        @map("vehicle_type")
  licenseNumber          String             @map("license_number")
  verificationStatus     VerificationStatus @default(pending) @map("verification_status")
  averageRating          Decimal?           @map("average_rating") @db.Decimal(3, 2)
  available              Boolean            @default(false)
  approvedAt             DateTime?          @map("approved_at")
  idFrontUrl             String             @map("id_front_url")
  idBackUrl              String             @map("id_back_url")
  vehicleRegistrationUrl String             @map("vehicle_registration_url")
  selfieWithIdUrl        String             @map("selfie_with_id_url")

  user               User                @relation(fields: [userId], references: [id])
  vehicles           Vehicle[]
  trips              Trip[]
  locationTracking   LocationTracking[]
  withdrawalRequests WithdrawalRequest[]
  incidentReports    IncidentReport[]

  @@map("drivers")
}

model Vehicle {
  id       String @id @default(uuid())
  driverId String @map("driver_id")
  brand    String
  model    String
  year     Int
  color    String
  plate    String @unique

  driver Driver @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model Trip {
  id                 String     @id @default(uuid())
  passengerId        String     @map("passenger_id")
  driverId           String?    @map("driver_id")
  originLat          Decimal    @map("origin_lat") @db.Decimal(9, 6)
  originLng          Decimal    @map("origin_lng") @db.Decimal(9, 6)
  originAddress      String     @map("origin_address")
  destinationLat     Decimal    @map("destination_lat") @db.Decimal(9, 6)
  destinationLng     Decimal    @map("destination_lng") @db.Decimal(9, 6)
  destinationAddress String     @map("destination_address")
  status             TripStatus @default(pending)
  distanceKm         Decimal    @map("distance_km") @db.Decimal(6, 2)
  fare               Decimal    @db.Decimal(8, 2)
  requestedAt        DateTime   @default(now()) @map("requested_at")
  arrivedAt          DateTime?  @map("arrived_at")
  startedAt          DateTime?  @map("started_at")
  completedAt        DateTime?  @map("completed_at")

  passenger        User                @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver           Driver?             @relation(fields: [driverId], references: [id])
  ratings          Rating[]
  locationTracking LocationTracking[]
  walletTxns       WalletTransaction[]
  notifications    Notification[]
  incidentReports  IncidentReport[]

  @@map("trips")
}

model LocationTracking {
  id         BigInt   @id @default(autoincrement())
  driverId   String   @map("driver_id")
  tripId     String?  @map("trip_id")
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver Driver @relation(fields: [driverId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@map("location_tracking")
}

model Rating {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  raterId   String   @map("rater_id")
  ratedId   String   @map("rated_id")
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  trip  Trip @relation(fields: [tripId], references: [id])
  rater User @relation("RaterRatings", fields: [raterId], references: [id])
  rated User @relation("RatedRatings", fields: [ratedId], references: [id])

  @@map("ratings")
}

model FareZone {
  id        String  @id @default(uuid())
  zoneName  String  @map("zone_name")
  baseFare  Decimal @map("base_fare") @db.Decimal(6, 2)
  farePerKm Decimal @map("fare_per_km") @db.Decimal(6, 2)
  centerLat Decimal @map("center_lat") @db.Decimal(9, 6)
  centerLng Decimal @map("center_lng") @db.Decimal(9, 6)

  @@map("fare_zones")
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique @map("user_id")
  balance Decimal @default(0) @db.Decimal(10, 2)

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String                @map("wallet_id")
  type              WalletTransactionType
  amount            Decimal               @db.Decimal(10, 2)
  tripReferenceId   String?               @map("trip_reference_id")
  paypalReferenceId String?               @map("paypal_reference_id")
  createdAt         DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  trip   Trip?  @relation(fields: [tripReferenceId], references: [id])

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id          String           @id @default(uuid())
  driverId    String           @map("driver_id")
  paypalEmail String           @map("paypal_email")
  amount      Decimal          @db.Decimal(10, 2)
  status      WithdrawalStatus @default(pending)
  requestedAt DateTime         @default(now()) @map("requested_at")
  resolvedAt  DateTime?        @map("resolved_at")
  adminId     String?          @map("admin_id")

  driver Driver @relation(fields: [driverId], references: [id])
  admin  User?  @relation("AdminResolvedWithdrawals", fields: [adminId], references: [id])

  @@map("withdrawal_requests")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          NotificationType
  title         String
  body          String
  relatedTripId String?          @map("related_trip_id")
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User  @relation(fields: [userId], references: [id])
  relatedTrip Trip? @relation(fields: [relatedTripId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model SavedAddress {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  label       SavedAddressLabel
  customLabel String?           @map("custom_label")
  address     String
  lat         Decimal           @db.Decimal(9, 6)
  lng         Decimal           @db.Decimal(9, 6)
  createdAt   DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("saved_addresses")
}

model IncidentReport {
  id               String                 @id @default(uuid())
  reporterId       String                 @map("reporter_id")
  tripId           String?                @map("trip_id")
  reportedDriverId String?                @map("reported_driver_id")
  category         IncidentReportCategory
  description      String
  status           IncidentReportStatus   @default(pending)
  createdAt        DateTime               @default(now()) @map("created_at")

  reporter       User    @relation("ReporterIncidentReports", fields: [reporterId], references: [id])
  trip           Trip?   @relation(fields: [tripId], references: [id])
  reportedDriver Driver? @relation(fields: [reportedDriverId], references: [id])

  @@map("incident_reports")
}
